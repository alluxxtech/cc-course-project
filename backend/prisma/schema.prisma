generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  email          String?
  displayName    String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories          Category[]
  transactions        Transaction[]
  monthlyBudgets      MonthlyBudget[]
  budgetAlertTriggers BudgetAlertTrigger[]

  @@unique([provider, providerUserId])
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  title      String
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  date       DateTime @db.Date
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date])
  @@index([userId, categoryId])
  @@map("transactions")
}

model MonthlyBudget {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}

model BudgetAlertTrigger {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  month       Int
  threshold   Int
  triggeredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, threshold])
  @@map("budget_alert_triggers")
}
